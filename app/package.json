{
  "name": "@greenmafia/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/make-notices.mjs --check && tsc --noEmit && vite build",
    "notices": "node scripts/make-notices.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "sounds": "node scripts/make-sounds.mjs",
    "icons": "python scripts/make-brand-icons.py",
    "graphics": "node scripts/make-game-graphics.mjs",
    "print-kit": "node scripts/make-print-kit.mjs"
  },
  "dependencies": {
    "@fontsource-variable/commissioner": "^5.3.0",
    "@fontsource/anonymous-pro": "^5.3.0",
    "@fontsource/bad-script": "^5.3.0",
    "@fontsource/oranienbaum": "^5.3.0",
    "@fontsource/rubik-dirt": "^5.3.0",
    "@greenmafia/engine": "*",
    "idb-keyval": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "fake-indexeddb": "^6.2.6",
    "happy-dom": "^21.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7"
  }
}
